+def broker_sluitmoment(werkelijk, open_time, nu: datetime) -> datetime | None:
+    """Het sluitmoment dat de broker noemt, als het bruikbaar is (1.10.4).
+
+    Uit het transactieoverzicht (``closed_at`` = ``dateUtc``). Alleen met een
+    tijd erin (een kale datum zou middernacht worden), niet vóór de opening en
+    niet meer dan een minuut na nu. Anders None: dan blijft het moment van
+    ontdekken staan.
+    """
+    gemeld = (werkelijk or {}).get("closed_at")
+    if not gemeld:
+        return None
+    try:
+        moment = datetime.fromisoformat(str(gemeld))
+    except (TypeError, ValueError):
+        return None
+    if not (moment.hour or moment.minute or moment.second):
+        return None
+    if moment.tzinfo is None:
+        moment = moment.replace(tzinfo=timezone.utc)
+    opende = _as_datetime(open_time, None) if open_time else None
+    if opende is not None and moment < opende:
+        return None
+    if moment > nu + timedelta(minutes=1):
+        return None
+    return moment
+
+
